{
  "info": {
    "name": "Research Opportunity Portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "id1", "value": "" },
    { "key": "id2", "value": "" },
    { "key": "id3", "value": "" }
  ],
  "item": [
    {
      "name": "1. Create Opportunity 1",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('id1', pm.response.json().id);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Machine Learning for Healthcare\",\n  \"description\": \"Applying ML models to medical image data.\",\n  \"research_area\": \"Artificial Intelligence\",\n  \"faculty_name\": \"Dr. Ahmad Khan\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, TensorFlow, Statistics\",\n  \"available_positions\": 3,\n  \"application_deadline\": \"2026-12-31\",\n  \"status\": \"Open\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/opportunities", "host": ["{{baseUrl}}"], "path": ["api", "opportunities"] }
      }
    },
    {
      "name": "2. Create Opportunity 2",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('id2', pm.response.json().id);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"IoT Based Smart Agriculture\",\n  \"description\": \"Sensor based monitoring system for crops.\",\n  \"research_area\": \"Internet of Things\",\n  \"faculty_name\": \"Dr. Sara Ali\",\n  \"department\": \"Electrical Engineering\",\n  \"required_skills\": \"Arduino, C++, Networking\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2026-11-30\",\n  \"status\": \"Open\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/opportunities", "host": ["{{baseUrl}}"], "path": ["api", "opportunities"] }
      }
    },
    {
      "name": "3. Create Opportunity 3",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('id3', pm.response.json().id);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Network Security Analysis\",\n  \"description\": \"Studying intrusion detection techniques.\",\n  \"research_area\": \"Cyber Security\",\n  \"faculty_name\": \"Dr. Usman Raza\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Networking, Linux, Python\",\n  \"available_positions\": 1,\n  \"application_deadline\": \"2026-12-15\",\n  \"status\": \"Open\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/opportunities", "host": ["{{baseUrl}}"], "path": ["api", "opportunities"] }
      }
    },
    {
      "name": "4. Get All Opportunities",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/opportunities", "host": ["{{baseUrl}}"], "path": ["api", "opportunities"] } }
    },
    {
      "name": "5. Get One Opportunity",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/opportunities/{{id1}}", "host": ["{{baseUrl}}"], "path": ["api", "opportunities", "{{id1}}"] } }
    },
    {
      "name": "6. Update Opportunity",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Machine Learning for Healthcare (Updated)\",\n  \"required_skills\": \"Python, PyTorch, Statistics\",\n  \"available_positions\": 5,\n  \"application_deadline\": \"2027-01-15\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/opportunities/{{id1}}", "host": ["{{baseUrl}}"], "path": ["api", "opportunities", "{{id1}}"] }
      }
    },
    {
      "name": "7. Change Status Open to Closed",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('Status is Closed', () => pm.expect(pm.response.json().status).to.eql('Closed'));"] } }],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"Closed\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/opportunities/{{id2}}", "host": ["{{baseUrl}}"], "path": ["api", "opportunities", "{{id2}}"] }
      }
    },
    {
      "name": "8. Delete Opportunity",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/opportunities/{{id3}}", "host": ["{{baseUrl}}"], "path": ["api", "opportunities", "{{id3}}"] } }
    },
    {
      "name": "9. Get Deleted Opportunity (404)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/opportunities/{{id3}}", "host": ["{{baseUrl}}"], "path": ["api", "opportunities", "{{id3}}"] } }
    },
    {
      "name": "10. Create With Invalid Data (400)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"department\": \"Computer Science\",\n  \"available_positions\": -2,\n  \"application_deadline\": \"not-a-date\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/opportunities", "host": ["{{baseUrl}}"], "path": ["api", "opportunities"] }
      }
    }
  ]
}
